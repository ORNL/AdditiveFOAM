FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      heatSourceDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

sources
{
    beam
    {
        path            scanPath;
        widthReference  D4Sigma;

        absorption
        {
            model       constant;
            eta         0.3;
        }

        heatSource
        {
            model       superGaussian;
            radius      (85.0e-6 85.0e-6);
            definition  secondMoment;
            depth       30e-6;
            k           2.0;
            nPoints     (10 10 10);
        }
    }
}

