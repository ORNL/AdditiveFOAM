FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      heatSourceDict;
}

sources
(
    testBeam
    skipBeam
    noHitBeam
    kellyConeBeam
    kellyCylinderBeam
    modifiedBeam
    projectedBeam
);

testBeam
{
    heatSourceModel      superGaussian;
    absorptionModel      constant;
    pathName             beamPath.dat;
    deltaT               0.4;
    hitPathIntervals     true;

    constantCoeffs
    {
        eta             0.35;
    }

    superGaussianCoeffs
    {
        dimensions      (2 2 4);
        k               2;
    }
}

