projectedBeam
{
    heatSourceModel      projectedGaussian;
    absorptionModel      constant;
    pathName             beamPath.dat;
    deltaT               0.4;
    hitPathIntervals     true;

    constantCoeffs
    {
        eta             0.35;
    }

    projectedGaussianCoeffs
    {
        dimensions      (1 2 16);
        A               3;
        B               0;
    }
}
