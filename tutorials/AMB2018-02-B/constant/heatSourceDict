FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      heatSourceProperties;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

sources (beam);

beam
{
    pathName            scanPath;    

    absorptionModel     constant;
    
    constantCoeffs
    {
        eta             0.33;
    }
    
    heatSourceModel     superGaussian;
    
    superGaussianCoeffs
    {
        k               2.0;
        dimensions      (85.0e-6 85.0e-6 30e-6);
        nPoints         (10 10 10);
    }
}

refinementModel
{
    refine                  true;
    
    nLevels                 1;
    
    refinementTemperature   1e6;//1250;
    
    //refinementModel         timeStep;
    refinementModel         refinementVolume;
    
    refinementVolumeCoeffs
    {
        cellsPerProc        5000;
        targetVolumeSafetyFactor       0.5;
        maxTargetVolumeGrowth          1.2;
        maxTargetVolumeShrink          0.8;
        postScanUpdateIntervalFactor   10;
    }

    minRefinementVolumeFactor          4;
    buffer      (85.0e-6 85.0e-6 100e-6);//(250e-6 250e-6 100e-6);
}

