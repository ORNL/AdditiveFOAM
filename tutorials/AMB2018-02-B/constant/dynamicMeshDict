FoamFile
{
    format      ascii;
    class       dictionary;
    object      dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

topoChanger
{    
    type    refiner;

    libs    ("libfvMeshTopoChangers.so");

    refineInterval  1;

    field           refinementField;

    lowerRefineLevel 0.1;

    upperRefineLevel 10.0;

    nBufferLayers   5;

    maxRefinement   1;

    maxCells        20000000;

    dumpLevel       true;
}

// Cell-count-based redistribution for parallel AMR. To enable it, change
// the type from none to distributor.
distributor
{
    type                    none;

    libs                    ("libfvMeshDistributors.so");

    redistributionInterval  10;

    maxImbalance            0.10;
}

