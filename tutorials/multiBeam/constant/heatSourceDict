FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      heatSourceDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

sources
{
    beam1
    {
        path            scanPath_1;
        widthReference  D4Sigma;

        absorption
        {
            model       constant;
            eta         0.33;
        }

        heatSource
        {
            model       superGaussian;
            radius      (85.0e-6 85.0e-6);
            depth       30e-6;
            k           2.0;
            nPoints     (10 10 10);
        }
    }

    beam2
    {
        path            scanPath_2;
        widthReference  D4Sigma;

        absorption
        {
            model       constant;
            eta         0.33;
        }

        heatSource
        {
            model       superGaussian;
            radius      (85.0e-6 85.0e-6);
            depth       30e-6;
            k           2.0;
            nPoints     (10 10 10);
        }
    }
}

refinement
{
    model                   none;
    
    refinementTemperature   1000;

    buffers
    {
        beam1               (85.0e-6 85.0e-6 100e-6);
        beam2               (85.0e-6 85.0e-6 100e-6);
    }

    targetCellsPerProc      5000;
    nBufferVolumes          4;
    maxSearchIter           10;
    timeTolerance           1e-4;
}

