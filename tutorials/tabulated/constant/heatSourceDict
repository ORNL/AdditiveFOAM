FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      heatSourceDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

sources (beam);

beam
{
    pathName            scanPath;    

    absorptionModel     constant;
    
    constantCoeffs
    {
        eta             0.2;
    }
    
    heatSourceModel     tabulated;
        
    tabulatedCoeffs
    {
        file        "beamProfile.txt";
        dimensions  (2.50e-4 2.50e-4 5.0e-5);
        A           0;
        B           1;
        nPoints     (10 10 10);
    }
}

refinementModel
{
    refinementModel         none;
}
