FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      heatSourceDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

sources
{
    beam
    {
        path            scanPath;
        widthReference  D4Sigma;
        depthReference  isotherm;

        absorption
        {
            model       Kelly;
            geometry    cone;
            eta0        0.28;
            etaMin      0.35;
        }

        heatSource
        {
            model       modifiedSuperGaussian;
            radius      (40.0e-6 40.0e-6);
            depth       20.0e-6;
            m           2.72;
            k           7.95;
            nPoints     (10 10 10);
        }
    }
}

refinement
{
    model                   none;

    //model                 targetCellLoad;
    
    refinementTemperature   1000;

    buffers
    {
        beam                (85.0e-6 85.0e-6 150e-6);
    }

    targetCellsPerProc      5000;
    nBufferVolumes          4;
    maxSearchIter           10;
    timeTolerance           1e-4;
}

