FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    "(bottom|sides)"
    {
        type            fixedFluxPressure;
    }

    top
    {
        type            totalPressure;
        p0              uniform 0;
    }
}

