FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

xmin -0.0005;
xmax 0.0025;
ymin -0.00075;
ymax 0.00075;
zmin -0.001;
zmax 0.0003;

vertices
(
    ($xmin $ymin $zmin)
    ($xmax $ymin $zmin)
    ($xmax $ymax $zmin)
    ($xmin $ymax $zmin)
    ($xmin $ymin $zmax)
    ($xmax $ymin $zmax)
    ($xmax $ymax $zmax)
    ($xmin $ymax $zmax)
);

// 10 um cells within 0.35 mm of the track and between z = -0.25 mm and
// z = 0.15 mm, coarsening toward the sides, the bottom and the top
blocks
(
    hex (0 1 2 3 4 5 6 7) (300 100 70)
    simpleGrading
    (
        1
        ((0.4 15 0.1667) (0.7 70 1) (0.4 15 6))
        ((0.75 23 0.1333) (0.4 40 1) (0.15 7 4))
    )
);

boundary
(
    bottom
    {
        type wall;
        faces
        (
            (0 3 2 1)
        );
    }
    top
    {
        type patch;
        faces
        (
            (4 5 6 7)
        );
    }
    sides
    {
        type wall;
        faces
        (
            (0 4 7 3)
            (1 2 6 5)
            (0 1 5 4)
            (3 7 6 2)
        );
    }
);

